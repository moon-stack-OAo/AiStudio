<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      启动窗默认对齐深色 App 主色，减轻冷启动闪色。
      系统栏图标明暗由 MainActivity SystemBarsBridge 按 App theme 运行时覆盖。
      注意：gen/android 可能被 tauri android init 覆盖。
    -->
    <style name="Theme.ai_studio" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/app_bg_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>
</resources>
