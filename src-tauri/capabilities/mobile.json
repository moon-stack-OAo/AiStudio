{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "mobile",
  "description": "Android/iOS 主界面能力：核心 + HTTP（无托盘/updater）",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    {
      "identifier": "http:default",
      "allow": [
        {"url": "https://**"},
        {"url": "http://**"},
        {"url": "https://*:*/**"},
        {"url": "http://*:*/**"}
      ],
      "deny": [
        {"url": "http://169.254.*.*"},
        {"url": "https://169.254.*.*"},
        {"url": "http://169.254.*.*:*"},
        {"url": "https://169.254.*.*:*"},
        {"url": "http://169.254.169.254"},
        {"url": "https://169.254.169.254"},
        {"url": "http://169.254.169.254:*"},
        {"url": "https://169.254.169.254:*"},
        {"url": "http://metadata.google.internal"},
        {"url": "https://metadata.google.internal"},
        {"url": "http://metadata.google.internal:*"},
        {"url": "https://metadata.google.internal:*"},
        {"url": "http://metadata.google"},
        {"url": "https://metadata.google"},
        {"url": "http://metadata.google:*"},
        {"url": "https://metadata.google:*"},
        {"url": "http://metadata"},
        {"url": "https://metadata"},
        {"url": "http://metadata:*"},
        {"url": "https://metadata:*"},
        {"url": "http://kubernetes.default"},
        {"url": "https://kubernetes.default"},
        {"url": "http://kubernetes.default:*"},
        {"url": "https://kubernetes.default:*"},
        {"url": "http://kubernetes.default.svc"},
        {"url": "https://kubernetes.default.svc"},
        {"url": "http://kubernetes.default.svc:*"},
        {"url": "https://kubernetes.default.svc:*"},
        {"url": "http://0.0.0.0"},
        {"url": "https://0.0.0.0"},
        {"url": "http://0.0.0.0:*"},
        {"url": "https://0.0.0.0:*"}
      ]
    }
  ]
}
