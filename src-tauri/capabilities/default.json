{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面主窗口默认能力：核心能力 + 关闭偏好相关 commands + updater",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-set-background-color",
    "core:webview:allow-set-webview-background-color",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:event:default",
    "updater:default",
    "process:default",
    "dialog:default",
    "fs:allow-write-file",
    "allow-confirm-close-action",
    "allow-get-close-action-pref",
    "allow-set-close-action-pref",
    {
      "identifier": "http:default",
      "allow": [
        {"url": "https://**"},
        {"url": "http://**"},
        {"url": "https://*:*/**"},
        {"url": "http://*:*/**"}
      ],
      "deny": [
        {"url": "http://169.254.*.*"},
        {"url": "https://169.254.*.*"},
        {"url": "http://169.254.*.*:*"},
        {"url": "https://169.254.*.*:*"},
        {"url": "http://169.254.169.254"},
        {"url": "https://169.254.169.254"},
        {"url": "http://169.254.169.254:*"},
        {"url": "https://169.254.169.254:*"},
        {"url": "http://metadata.google.internal"},
        {"url": "https://metadata.google.internal"},
        {"url": "http://metadata.google.internal:*"},
        {"url": "https://metadata.google.internal:*"},
        {"url": "http://metadata.google"},
        {"url": "https://metadata.google"},
        {"url": "http://metadata.google:*"},
        {"url": "https://metadata.google:*"},
        {"url": "http://metadata"},
        {"url": "https://metadata"},
        {"url": "http://metadata:*"},
        {"url": "https://metadata:*"},
        {"url": "http://kubernetes.default"},
        {"url": "https://kubernetes.default"},
        {"url": "http://kubernetes.default:*"},
        {"url": "https://kubernetes.default:*"},
        {"url": "http://kubernetes.default.svc"},
        {"url": "https://kubernetes.default.svc"},
        {"url": "http://kubernetes.default.svc:*"},
        {"url": "https://kubernetes.default.svc:*"},
        {"url": "http://0.0.0.0"},
        {"url": "https://0.0.0.0"},
        {"url": "http://0.0.0.0:*"},
        {"url": "https://0.0.0.0:*"},
        {"url": "http://[::]"},
        {"url": "https://[::]"},
        {"url": "http://[::]:*"},
        {"url": "https://[::]:*"},
        {"url": "http://[::1]"},
        {"url": "https://[::1]"},
        {"url": "http://[::1]:*"},
        {"url": "https://[::1]:*"},
        {"url": "http://[fd00:ec2::254]"},
        {"url": "https://[fd00:ec2::254]"},
        {"url": "http://[fd00:ec2::254]:*"},
        {"url": "https://[fd00:ec2::254]:*"},
        {"url": "http://[::ffff:169.254.169.254]"},
        {"url": "https://[::ffff:169.254.169.254]"},
        {"url": "http://[::ffff:169.254.169.254]:*"},
        {"url": "https://[::ffff:169.254.169.254]:*"},
        {"url": "http://[::ffff:a9fe:a9fe]"},
        {"url": "https://[::ffff:a9fe:a9fe]"},
        {"url": "http://[::ffff:a9fe:a9fe]:*"},
        {"url": "https://[::ffff:a9fe:a9fe]:*"},
        {"url": "http://[::ffff:169.254.*.*]"},
        {"url": "https://[::ffff:169.254.*.*]"},
        {"url": "http://[::ffff:169.254.*.*]:*"},
        {"url": "https://[::ffff:169.254.*.*]:*"}
      ]
    }
  ]
}
