{
  "name": "ai_studio",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config vite.desktop.config.js",
    "dev:desktop": "vite --config vite.desktop.config.js",
    "dev:android": "vite --config vite.android.config.js",
    "build": "vite build --config vite.desktop.config.js",
    "build:desktop": "vite build --config vite.desktop.config.js",
    "build:android": "vite build --config vite.android.config.js",
    "preview": "vite preview --config vite.desktop.config.js",
    "preview:android": "vite preview --config vite.android.config.js --outDir dist-android",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build --bundles nsis,msi",
    "tauri:build:check": "node .github/scripts/check-bundle.mjs",
    "win:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1",
    "tauri:android:init": "tauri android init --ci",
    "tauri:build:android": "tauri android build --apk --ci --target aarch64",
    "tauri:build:android:debug": "node ./scripts/run-timed.mjs tauri android build --apk --ci --target aarch64 --debug",
    "android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-debug.ps1",
    "android:studio": "tauri android dev --open",
    "android:studio:host": "tauri android dev --open --host",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-cache.ps1",
    "clean:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-cache.ps1 -DryRun",
    "clean:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-cache.ps1 -IncludeNodeModules",
    "check:theme": "node ./scripts/check-theme-sync.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vicons/ionicons5": "^0.13.0",
    "axios": "^1.19.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "naive-ui": "^2.45.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
