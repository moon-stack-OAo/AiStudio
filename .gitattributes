# 统一文本文件为 LF，避免 Windows autocrlf 产生假脏文件
* text=auto eol=lf

# 显式按扩展名约束常见源码
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.md text eol=lf
*.scss text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.rs text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# 二进制不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp4 binary
*.webm binary
*.apk binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
